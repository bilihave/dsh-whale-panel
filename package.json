{
  "name": "dsh-whale-panel",
  "version": "1.28.0",
  "type": "module",
  "description": "白鲸台 · DeepSeek Harness 常驻浮窗：按概率学习你的 B站 兴趣并按半衰期淡忘，在 token 额度内挑片，契合度达标才 @ 你，评论有日上限与脱敏闸，政治/政府/前沿科学一律不评价。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bilibili-plugin",
    "recommendation",
    "curation",
    "interest-profile",
    "personalization",
    "floating-panel"
  ],
  "author": "bilihave",
  "license": "MIT",
  "homepage": "https://github.com/bilihave/dsh-whale-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilihave/dsh-whale-panel.git"
  },
  "bugs": {
    "url": "https://github.com/bilihave/dsh-whale-panel/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "tools/*.cjs"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node tools/render-probe.cjs empty && node tools/render-probe.cjs full && node tools/render-probe.cjs cap && node tools/render-probe.cjs paused",
    "pack:dry": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
