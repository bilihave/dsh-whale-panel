{
  "name": "dsh-whale-panel",
  "version": "1.27.0",
  "private": true,
  "type": "module",
  "description": "白鲸台 · DeepSeek Harness 常驻浮窗：按概率自动学习主人兴趣、刷 B站挑推荐、@ 主人、实时学习评论区语气、按预算封顶，并把长期观察沉淀成留言区等你反馈。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "recommendation",
    "personalization"
  ],
  "author": "bilihave",
  "license": "MIT",
  "homepage": "https://github.com/bilihave/dsh-whale-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilihave/dsh-whale-panel.git"
  },
  "bugs": {
    "url": "https://github.com/bilihave/dsh-whale-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
